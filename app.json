{
  "expo": {
    "name": "PageQuest Reading Tracker",
    "slug": "bostainj",
    "scheme": "pagequest",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#14233C"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "myapp.pagequest",
      "buildNumber": "2",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "pan",
      "package": "myapp.pagequest",
      "versionCode": 4,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#14233C"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "owner": "dreams-come-true",
    "extra": {
      "eas": {
        "projectId": "95fe592d-3fd5-42a0-a0fd-2182edf3d260"
      }
    }
  }
}
