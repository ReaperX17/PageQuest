# ============================================================================
# PageQuest Reading Tracker - Environment Configuration (.env)
# Copy this file to .env for local development, or upload to EAS via:
#   eas env:create --scope project
# ============================================================================

# 1. Google Gemini API Key (for AI Reading Comprehension Quiz Generation)
# Get a key at: https://aistudio.google.com/apikey
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# 2. Firebase Cloud Sync (Multi-Device Parent/Co-Parent/Child Sync)
# Create a project at: https://console.firebase.google.com
# Enable Cloud Firestore, then copy your Web App config values below:
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# 3. Optional App Store / Deep Link / SMS Webhook Configuration
EXPO_PUBLIC_APP_DOWNLOAD_URL=https://pagequest.app
EXPO_PUBLIC_IOS_STORE_URL=https://apps.apple.com/app/pagequest-reading-tracker
EXPO_PUBLIC_ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=com.readingtracker.app
EXPO_PUBLIC_SMS_WEBHOOK_URL=
